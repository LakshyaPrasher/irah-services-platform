# IRAH Services LLP - Digital Platform Configuration Template
# Copy this file to `irah.env` and update the parameters.

# Target recipient for financial diagnostic reports
IRAH_REPORT_TO=destination_email@example.com

# OPTION A (RECOMMENDED): Google Account App Password for Direct SMTP
# Generate via: Google Account > Security > 2-Step Verification > App passwords
IRAH_SMTP_USER=your_sender_account@gmail.com
# IRAH_GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# OPTION B: Resend API Configuration
# Sign up at https://resend.com and obtain an API key
IRAH_RESEND_API_KEY=your_resend_api_key_here
# IRAH_MAIL_DOMAIN=yourverifieddomain.com

# Admin Security Key for protected endpoints (/api/inquiries)
# If omitted, a cryptographically secure key is auto-generated on server start.
# IRAH_ADMIN_KEY=your_secure_admin_key
